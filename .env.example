# --- Backend & Database Configuration ---
# Defaults to local SQLite file for zero-config startup; set to PostgreSQL for production
DATABASE_URL=sqlite:///./banking_optimizer.db
# PostgreSQL example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/banking_db

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=banking-ai-secret-key-production-ready-2026-tcs
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- Redis Streams & Real-time Alerts ---
# Set to Redis URL; backend automatically falls back to in-memory event bus if Redis is offline
REDIS_URL=redis://localhost:6379/0

# --- Frontend CORS ---
FRONTEND_URL=http://localhost:3000

# --- Seeding & Demo ---
DEMO_PASSWORD=BankDemo#2026

# --- Logging & Pipeline ---
LOG_LEVEL=INFO
RANDOM_SEED=42
