# Environment variables for Intelligent Branch Load Optimizer
# Database / Storage (Optional - Defaults to SQLite / Parquet / CSV local storage)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=branch_load_db
DB_USER=postgres
DB_PASSWORD=postgres_secret_change_me

# Redis / Stream Configuration (Optional - Defaults to local in-memory fallback)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_KEY=branch_events

# Pipeline Settings
RANDOM_SEED=42
DATA_GENERATION_DAYS=90
LOG_LEVEL=INFO
